{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "team-signals",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The dashboard: public/ is served as static assets; /api/* goes to the Worker first.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-signals",
      // Cloud database (created 13 Nov 2026, region WEUR). Local development uses a local copy.
      "database_id": "e90a802e-376d-416c-b3d1-2984fa47d1c4",
      "migrations_dir": "migrations"
    }
  ],
  // Run now: the Worker starts .github/workflows/weekly-run.yml in this repo.
  // Secrets, set with `npx wrangler secret put`: GITHUB_TOKEN, RUN_PASSCODE.
  // The Monday run: 03:17 UTC starts it, 06:17 UTC checks it and starts it again if no run succeeded today.
  "triggers": { "crons": ["17 3 * * 1", "17 6 * * 1"] },
  "vars": { "GITHUB_REPO": "shirakohavi/growth-signals-greenfield", "WORKFLOW_FILE": "weekly-run.yml" }
}
