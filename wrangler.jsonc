{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "team-signals",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-signals",
      // No database_id yet: local dev works without one. On first deploy (step 8) Wrangler
      // provisions the database automatically, or run `npx wrangler d1 create team-signals`.
      "migrations_dir": "migrations"
    }
  ]
  // Cron Triggers (step 8) and the ANTHROPIC_API_KEY secret (`wrangler secret put`, step 4) are added later.
}
